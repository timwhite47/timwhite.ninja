---
import { getEntry } from 'astro:content';
import { resolveFiles } from '../../lib/evidence-files';
import Island from '../Island.astro';

interface Props {
  evidence: string;
  file?: string;
  caption?: string;
  autoplay?: boolean;
}
const { evidence, file, caption, autoplay = false } = Astro.props;
const entry = await getEntry('evidence', evidence);
if (!entry) throw new Error(`<SwarmReplay evidence="${evidence}"> matches no evidence entry`);
const files = resolveFiles(entry);
const f = file ? files.find((x) => x.path === file) : files.find((x) => x.role === 'primary');
if (!f) throw new Error(`<SwarmReplay> could not find a CSV in evidence "${evidence}"`);
---

<Island name="swarm-replay" caption={caption} fallbackHref={f.url} fallbackText="Download the CSV">
  <swarm-replay data-src={f.url} data-autoplay={autoplay ? 'true' : 'false'}>
    <div class="replay-toolbar">
      <button type="button" data-action="toggle" aria-pressed="false">Play</button>
      <input type="range" data-action="scrub" min="0" max="1000" value="0" aria-label="Time" />
      <select data-action="speed" aria-label="Speed">
        <option value="1">1×</option>
        <option value="4">4×</option>
        <option value="16" selected>16×</option>
      </select>
    </div>
    <canvas
      role="img"
      aria-label="Agents acting on the board and on the second target over one simulated day; see the live summary below"
    ></canvas>
    <output data-role="status" aria-live="polite">Loading…</output>
  </swarm-replay>
</Island>

<script>
  class SwarmReplay extends HTMLElement {
    cleanup?: () => void;
    connectedCallback() {
      const io = new IntersectionObserver(
        async ([e]) => {
          if (!e?.isIntersecting) return;
          io.disconnect();
          const { mount } = await import('../../islands/swarm-replay');
          this.cleanup = mount(this);
        },
        { rootMargin: '200px' },
      );
      io.observe(this);
    }
    disconnectedCallback() {
      this.cleanup?.();
    }
  }
  if (!customElements.get('swarm-replay')) customElements.define('swarm-replay', SwarmReplay);
</script>
