---
import type { ResolvedFile } from '../lib/evidence-files';
import { fmtBytes } from '../lib/format';

interface Props {
  files: ResolvedFile[];
}
const { files } = Astro.props;
---

<div class="table-wrap">
  <table class="files">
    <thead>
      <tr><th>File</th><th>Role</th><th>Type</th><th class="num">Size</th><th>SHA-256</th><th>Get</th></tr>
    </thead>
    <tbody>
      {
        files.map((f) => (
          <tr>
            <td>
              {f.label}
              <br />
              <code>{f.path}</code>
            </td>
            <td>{f.role}</td>
            <td><code>{f.mediaType}</code></td>
            <td class="num">{fmtBytes(f.bytes)}</td>
            <td><code class="hash">{f.sha256}</code></td>
            <td class="actions">
              <a href={f.url}>View</a> · <a href={f.url} download={f.path}>Download</a>
            </td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
